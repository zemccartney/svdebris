{
    "name": "astro-image-svg-workspace",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm -r build",
        "deps": "ncu -p pnpm --format group --cooldown 7d --workspaces --root",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "knip": "knip --production --strict",
        "lint": "eslint --flag unstable_native_nodejs_ts_config",
        "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --fix",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "use-astro": "node scripts/use-astro.ts"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@grepco/astro-image-svg": "workspace:*",
        "@types/node": "catalog:",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.1.0",
        "eslint-plugin-jsdoc": "^64.3.6",
        "eslint-plugin-package-json": "^1.8.0",
        "eslint-plugin-perfectionist": "^5.11.0",
        "eslint-plugin-unicorn": "^74.0.0",
        "eslint-plugin-workspaces": "^0.12.1",
        "knip": "^6.34.0",
        "npm-check-updates": "^23.1.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "catalog:",
        "typescript-eslint": "^8.69.0"
    },
    "engines": {
        "node": "24"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "error"
        }
    }
}
